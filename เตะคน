-- 4. ระบบป้องกันขั้นสุดยอด (Ultimate Anti-Grab & Auto-Push Aura)
RunService.Stepped:Connect(function()
    if not antiGrabEnabled then return end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myHrp = LocalPlayer.Character.HumanoidRootPart
        
        -- ล้างค่าความเร็วผิดปกติที่โดนซัด
        if myHrp.AssemblyLinearVelocity.Magnitude > 75 then
            myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            myHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end

        -- เคลียร์ Weld แปลกปลอมที่คนอื่นพยายามเอามาเชื่อมติดกับตัวเรา
        for _, obj in ipairs(LocalPlayer.Character:GetDescendants()) do
            if obj:IsA("Weld") or obj:IsA("WeldConstraint") or obj:IsA("Motor6D") then
                if obj.Part1 and obj.Part1.Parent ~= LocalPlayer.Character then
                    obj:Destroy()
                end
            end
        end

        -- ออร่าผลักคนอื่น: ถ้าใครเข้ามาประชิดตัวใกล้เกิน 4 บล็อก จะดีดตัวคนนั้นกระเด็นออกทันที
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local otherHrp = player.Character.HumanoidRootPart
                local dist = (otherHrp.Position - myHrp.Position).Magnitude
                if dist < 4 then
                    -- ส่งแรงดีดคนอื่นออกไปไกลทันทีที่เข้ามาใกล้
                    otherHrp.AssemblyLinearVelocity = (otherHrp.Position - myHrp.Position).Unit * 15000 + Vector3.new(0, 5000, 0)
                end
            end
        end
    end
end)

-- 5. ฟังก์ชันหากลุ่มเป้าหมายในวงกลม FOV
local function getClosestPlayerInFOV()
    local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closestTarget = nil
    local shortestDist = 100

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            local screenPoint, onScreen = Camera:WorldToScreenPoint(hrp.Position)
            
            if onScreen then
                local screenVector = Vector2.new(screenPoint.X, screenPoint.Y)
                local dist = (screenVector - mousePos).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestTarget = hrp
                end
            end
        end
    end
    return closestTarget
end

-- 6. ระบบซัดปลิว Godtier Fling
local function triggerGodtierFling(targetHrp)
    if not targetHrp or not targetHrp.Parent then return end
    
    local connection
    local startTime = tick()
    
    connection = RunService.RenderStepped:Connect(function()
        if not targetHrp or not targetHrp.Parent then
            if connection then connection:Disconnect() end
            return
        end
        
        targetHrp.AssemblyLinearVelocity = Camera.CFrame.LookVector * 500000 + Vector3.new(0, 300000, 0)
        targetHrp.AssemblyAngularVelocity = Vector3.new(999999, 999999, 999999)
        
        if tick() - startTime > 0.3 then
            if connection then connection:Disconnect() end
        end
    end)
end

-- 7. ดักจับการคลิกเพื่อทำงาน
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not flingEnabled then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local mousePos = UserInputService:GetMouseLocation()
        local absPos = mainFrame.AbsolutePosition
        local absSize = mainFrame.AbsoluteSize
        
        if mousePos.X >= absPos.X and mousePos.X <= absPos.X + absSize.X and mousePos.Y >= absPos.Y and mousePos.Y <= absPos.Y + absSize.Y then
            return 
        end
        
        local targetHrp = getClosestPlayerInFOV()
        if targetHrp then
            triggerGodtierFling(targetHrp)
        end
    end
end)

